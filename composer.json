{
  "name": "davidannebicque/twig-to-word-bundle",
  "description": "Render Word documents from Twig templates in Symfony",
  "type": "symfony-bundle",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-dom": "*",
    "ext-libxml": "*",
    "phpoffice/phpword": "^1.3",
    "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
    "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4": {
      "Davidannebicque\\TwigToWordBundle\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Davidannebicque\\TwigToWordBundle\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit tests",
    "lint": "@php -l src/TwigToWordBundle.php"
  }
}
